}
}

@layer base {
  *, ::after, ::before, ::backdrop { box-sizing: border-box; border: 0px solid; margin: 0px; padding: 0px; }
  ::-webkit-file-upload-button { box-sizing: border-box; border: 0px solid; margin: 0px; padding: 0px; }
  ::file-selector-button { box-sizing: border-box; border: 0px solid; margin: 0px; padding: 0px; }
  html, :host { text-size-adjust: 100%; tab-size: 4; line-height: 1.5; font-family: var(--default-font-family,ui-sans-serif,system-ui,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol","Noto Color Emoji"); font-feature-settings: var(--default-font-feature-settings,normal); font-variation-settings: var(--default-font-variation-settings,normal); -webkit-tap-highlight-color: transparent; }
  hr { height: 0px; color: inherit; border-top-width: 1px; }
  abbr:where([title]) { text-decoration: underline dotted; }
  h1, h2, h3, h4, h5, h6 { font-size: inherit; font-weight: inherit; }
  a { color: inherit; text-decoration: inherit; }
  b, strong { font-weight: bolder; }
  code, kbd, samp, pre { font-family: var(--default-mono-font-family,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace); font-feature-settings: var(--default-mono-font-feature-settings,normal); font-variation-settings: var(--default-mono-font-variation-settings,normal); font-size: 1em; }
  small { font-size: 80%; }
  sub, sup { vertical-align: baseline; font-size: 75%; line-height: 0; position: relative; }
  sub { bottom: -0.25em; }
  sup { top: -0.5em; }
  table { text-indent: 0px; border-color: inherit; border-collapse: collapse; }
  progress { vertical-align: baseline; }
  summary { display: list-item; }
  ol, ul, menu { list-style: none; }
  img, svg, video, canvas, audio, iframe, embed, object { vertical-align: middle; display: block; }
  img, video { max-width: 100%; height: auto; }
  button, input, select, optgroup, textarea { font: inherit; letter-spacing: inherit; color: inherit; opacity: 1; background-color: rgba(0, 0, 0, 0); border-radius: 0px; }
  ::-webkit-file-upload-button { font: inherit; letter-spacing: inherit; color: inherit; opacity: 1; background-color: rgba(0, 0, 0, 0); border-radius: 0px; }
  ::file-selector-button { font: inherit; letter-spacing: inherit; color: inherit; opacity: 1; background-color: rgba(0, 0, 0, 0); border-radius: 0px; }
  :where(select:is([multiple], [size])) optgroup { font-weight: bolder; }
  :where(select:is([multiple], [size])) optgroup option { padding-inline-start: 20px; }
  ::-webkit-file-upload-button { margin-inline-end: 4px; }
  ::file-selector-button { margin-inline-end: 4px; }
  ::placeholder { opacity: 1; }
  @supports (not (-webkit-appearance:-apple-pay-button)) or (contain-intrinsic-size:1px) {
  ::placeholder { color: currentcolor; }
  @supports (color:color-mix(in lab,red,red)) {
  ::placeholder { color: color-mix(currentcolor, transparent); }
}
}
  textarea { resize: vertical; }
  ::-webkit-search-decoration { appearance: none; }
  ::-webkit-date-and-time-value { min-height: 1lh; text-align: inherit; }
  ::-webkit-datetime-edit { display: inline-flex; }
  ::-webkit-datetime-edit-fields-wrapper { padding: 0px; }
  ::-webkit-datetime-edit { padding-block: 0px; }
  ::-webkit-datetime-edit-year-field { padding-block: 0px; }
  ::-webkit-datetime-edit-month-field { padding-block: 0px; }
  ::-webkit-datetime-edit-day-field { padding-block: 0px; }
  ::-webkit-datetime-edit-hour-field { padding-block: 0px; }
  ::-webkit-datetime-edit-minute-field { padding-block: 0px; }
  ::-webkit-datetime-edit-second-field { padding-block: 0px; }
  ::-webkit-datetime-edit-millisecond-field { padding-block: 0px; }
  ::-webkit-datetime-edit-meridiem-field { padding-block: 0px; }
  button, input:where([type="button"], [type="reset"], [type="submit"]) { appearance: button; }
  ::-webkit-file-upload-button { appearance: button; }
  ::file-selector-button { appearance: button; }
  ::-webkit-inner-spin-button { height: auto; }
  ::-webkit-outer-spin-button { height: auto; }
  [hidden]:where(:not([hidden="until-found"])) { display: none !important; }
  *, ::after, ::before, ::backdrop { border-color: var(--color-gray-200,currentColor); }
  ::-webkit-file-upload-button { border-color: var(--color-gray-200,currentColor); }
  ::file-selector-button { border-color: var(--color-gray-200,currentColor); }
  :root { --color-bg-bg: #fff; --color-bg-page: #f8f8f8; --color-bg-hover: #0d0d0d0d; --color-bg-surface: #f0f0f0; --color-bg-overlay: #e6e6e6; --color-bg-subtle: #d9d9d9; --color-bg-warning: #fff4eb; --color-bg-error: #fff0f0; --color-interactive-bg-primary-default: #000; --color-interactive-bg-primary-page: #0d0d0dcc; --color-interactive-bg-primary-press: #0d0d0de5; --color-interactive-bg-primary-inactive: #000; --color-interactive-bg-primary-selected: #000; --color-interactive-bg-primary-disabled: #e6e6e6; --color-interactive-bg-secondary-default: #0d0d0d00; --color-interactive-bg-secondary-page: #0d0d0d05; --color-interactive-bg-secondary-press: #0d0d0d0d; --color-interactive-bg-secondary-inactive: #0d0d0d00; --color-interactive-bg-secondary-selected: #0d0d0d0d; --color-interactive-bg-tertiary-default: #fff; --color-interactive-bg-tertiary-page: #f8f8f8; --color-interactive-bg-tertiary-press: #f0f0f0; --color-interactive-bg-tertiary-inactive: #fff; --color-interactive-bg-tertiary-selected: #fff; --color-border-default: #0d0d0d1a; --color-border-strong: #0d0d0d26; --color-text-primary: #0d0d0d; --color-text-secondary: #5c5c5c; --color-text-tertiary: #888; --color-text-inverted: #fff; --color-text-inverted-static: #fff; --color-text-placeholder: #adadad; --color-text-accent: #0b7fff; --color-icon-primary: #0d0d0d; --color-icon-secondary: #5c5c5c; --color-icon-tertiary: #888; --color-icon-blue: #0b7fff; --color-icon-red: #e03131; --color-icon-orange: #e07b00; --color-icon-green: #1e8a3e; --color-icon-purple: #9e77ed; --color-accent-blue-default: #0b7fff; --color-accent-blue-hover: #06d; --color-accent-blue-pressed: #004fbb; --color-accent-blue-subtle: #ebf4ff; --color-accent-blue-border: #80beff; --color-accent-blue-text: #002677; --color-accent-red-default: #e03131; --color-accent-red-hover: #bf2020; --color-accent-red-pressed: #9e1010; --color-accent-red-subtle: #fff0f0; --color-accent-red-border: #f99; --color-accent-red-text: #5f0000; --color-accent-orange-default: #e07b00; --color-accent-orange-hover: #c46a00; --color-accent-orange-pressed: #a85800; --color-accent-orange-subtle: #fff4eb; --color-accent-orange-border: #ffb26b; --color-accent-orange-text: #703500; --color-accent-green-default: #1e8a3e; --color-accent-green-hover: #157530; --color-accent-green-pressed: #0d6025; --color-accent-green-subtle: #edfaf2; --color-accent-green-border: #87d9a4; --color-accent-green-text: #023b14; --color-accent-purple-default: #9e77ed; --color-accent-purple-hover: #7c55d4; --color-accent-purple-pressed: #5e3ab8; --color-accent-purple-subtle: #f5f3ff; --color-accent-purple-border: #d9d1fb; --color-accent-purple-text: #2c1478; }
  .dark { --color-bg-bg: #2b2b2b; --color-bg-page: #161616; --color-bg-hover: #ffffff0d; --color-bg-surface: #202020; --color-bg-overlay: #2b2b2b; --color-bg-subtle: #363636; --color-bg-warning: #542500; --color-bg-error: #420000; --color-interactive-bg-primary-default: #fff; --color-interactive-bg-primary-page: #ffffffe5; --color-interactive-bg-primary-press: #fffc; --color-interactive-bg-primary-inactive: #fff; --color-interactive-bg-primary-selected: #fff; --color-interactive-bg-primary-disabled: #363636; --color-interactive-bg-secondary-default: #fff0; --color-interactive-bg-secondary-page: #ffffff1a; --color-interactive-bg-secondary-press: #ffffff0d; --color-interactive-bg-secondary-inactive: #fff0; --color-interactive-bg-secondary-selected: #ffffff1a; --color-interactive-bg-tertiary-default: #2b2b2b; --color-interactive-bg-tertiary-page: #161616; --color-interactive-bg-tertiary-press: #000; --color-interactive-bg-tertiary-inactive: #2b2b2b; --color-interactive-bg-tertiary-selected: #2b2b2b; --color-border-default: #ffffff1a; --color-border-strong: #ffffff26; --color-text-primary: #f8f8f8; --color-text-secondary: #adadad; --color-text-tertiary: #747474; --color-text-inverted: #000; --color-text-inverted-static: #fff; --color-text-placeholder: #474747; --color-text-accent: #4099ff; --color-icon-primary: #f8f8f8; --color-icon-secondary: #adadad; --color-icon-tertiary: #747474; --color-icon-blue: #80beff; --color-icon-red: #f99; --color-icon-orange: #ffb26b; --color-icon-green: #87d9a4; --color-icon-purple: #a888f2; --color-accent-blue-default: #4099ff; --color-accent-blue-hover: #4099ff; --color-accent-blue-pressed: #99c7ff; --color-accent-blue-subtle: #001d3d; --color-accent-blue-border: #003a80; --color-accent-blue-text: #99c7ff; --color-accent-red-default: #ff5c5c; --color-accent-red-hover: #f99; --color-accent-red-pressed: #e03131; --color-accent-red-subtle: #2d0000; --color-accent-red-border: #6b0000; --color-accent-red-text: #ffb3b3; --color-accent-orange-default: #ff8a30; --color-accent-orange-hover: #ffb26b; --color-accent-orange-pressed: #e07b00; --color-accent-orange-subtle: #2a1500; --color-accent-orange-border: #630; --color-accent-orange-text: #ffcb8a; --color-accent-green-default: #46bf72; --color-accent-green-hover: #87d9a4; --color-accent-green-pressed: #1e8a3e; --color-accent-green-subtle: #001f0d; --color-accent-green-border: #0a4d22; --color-accent-green-text: #88dda8; --color-accent-purple-default: #7b5ce5; --color-accent-purple-hover: #a888f2; --color-accent-purple-pressed: #4a32a8; --color-accent-purple-subtle: #160d38; --color-accent-purple-border: #2a1a6e; --color-accent-purple-text: #bea4f7; }
  html { font-family: var(--font-sans); }
  pre { font-family: var(--font-mono); white-space: pre-wrap; }
  button { cursor: pointer; }
  button:focus:not(:focus-visible) { outline: none; }
  input::placeholder, textarea::placeholder { color: var(--color-gray-400,#b4b4b4); }
}

@layer components;

@layer utilities {
  .\@container\/input { container: input / inline-size; }
  .\@container\/review-info { container: review-info / inline-size; }
  .\@container { container-type: inline-size; }
  .pointer-events-auto { pointer-events: auto; }
  .pointer-events-none { pointer-events: none; }
  .collapse { visibility: collapse; }
  .invisible { visibility: hidden; }
  .visible { visibility: visible; }
  .sr-only { clip: rect(0px, 0px, 0px, 0px); white-space: nowrap; border-width: 0px; width: 1px; height: 1px; margin: -1px; padding: 0px; position: absolute; overflow: hidden; }
  .absolute { position: absolute; }
  .fixed { position: fixed; }
  .relative { position: relative; }
  .static { position: static; }
  .sticky { position: sticky; }
  .inset-0 { inset: calc(var(--spacing)*0); }
  .inset-x-0 { inset-inline: calc(var(--spacing)*0); }
  .inset-x-\[13px\] { inset-inline: 13px; }
  .inset-y-0 { inset-block: calc(var(--spacing)*0); }
  .inset-y-\[0\.5px\] { inset-block: 0.5px; }
  .inset-y-px { inset-block: 1px; }
  .-top-0\.5 { top: calc(var(--spacing)*-.5); }
  .-top-0\.25 { top: calc(var(--spacing)*-.25); }
  .-top-1\.5 { top: calc(var(--spacing)*-1.5); }
  .-top-2 { top: calc(var(--spacing)*-2); }
  .-top-12 { top: calc(var(--spacing)*-12); }
  .-top-\[34px\] { top: -34px; }
  .top-0 { top: calc(var(--spacing)*0); }
  .top-0\.5 { top: calc(var(--spacing)*.5); }
  .top-1 { top: calc(var(--spacing)*1); }
  .top-1\.5 { top: calc(var(--spacing)*1.5); }
  .top-1\/2 { top: 50%; }
  .top-2 { top: calc(var(--spacing)*2); }
  .top-2\.5 { top: calc(var(--spacing)*2.5); }
  .top-3 { top: calc(var(--spacing)*3); }
  .top-4 { top: calc(var(--spacing)*4); }
  .top-5 { top: calc(var(--spacing)*5); }
  .top-8 { top: calc(var(--spacing)*8); }
  .top-10 { top: calc(var(--spacing)*10); }
  .top-\[-4\.5px\] { top: -4.5px; }
  .top-\[-5px\] { top: -5px; }
  .top-\[-20px\] { top: -20px; }
  .top-\[-127px\] { top: -127px; }
  .top-\[-146px\] { top: -146px; }
  .top-\[2px\] { top: 2px; }
  .top-\[9px\] { top: 9px; }
  .top-\[15px\] { top: 15px; }
  .top-\[19px\] { top: 19px; }

:is(#altTextSettingsDialog #altTextSettingsContainer) #createModelDescription, :is(#altTextSettingsDialog #altTextSettingsContainer) #aiModelSettings, :is(#altTextSettingsDialog #altTextSettingsContainer) #showAltTextDialogDescription { padding-inline-start: 40px; }

:is(#altTextSettingsDialog #altTextSettingsContainer) #automaticSettings { display: flex; flex-direction: column; gap: 16px; }


.tippy-box[data-animation="fade"][data-state="hidden"] { opacity: 0; }

[data-tippy-root] { max-width: calc(-10px + 100vw); }

.tippy-box { position: relative; background-color: rgb(51, 51, 51); color: rgb(255, 255, 255); border-radius: 4px; font-size: 14px; line-height: 1.4; white-space: normal; outline: 0px; transition-property: transform, visibility, opacity; }

.tippy-box[data-placement^="top"] > .tippy-arrow { bottom: 0px; }

.tippy-box[data-placement^="top"] > .tippy-arrow::before { bottom: -7px; left: 0px; border-width: 8px 8px 0px; border-top-color: initial; transform-origin: center top; }

.tippy-box[data-placement^="bottom"] > .tippy-arrow { top: 0px; }

.tippy-box[data-placement^="bottom"] > .tippy-arrow::before { top: -7px; left: 0px; border-width: 0px 8px 8px; border-bottom-color: initial; transform-origin: center bottom; }

.tippy-box[data-placement^="left"] > .tippy-arrow { right: 0px; }

.tippy-box[data-placement^="left"] > .tippy-arrow::before { border-width: 8px 0px 8px 8px; border-left-color: initial; right: -7px; transform-origin: left center; }

.tippy-box[data-placement^="right"] > .tippy-arrow { left: 0px; }

.tippy-box[data-placement^="right"] > .tippy-arrow::before { left: -7px; border-width: 8px 8px 8px 0px; border-right-color: initial; transform-origin: right center; }

.tippy-box[data-inertia][data-state="visible"] { transition-timing-function: cubic-bezier(0.54, 1.5, 0.38, 1.11); }

.tippy-arrow { width: 16px; height: 16px; color: rgb(51, 51, 51); }

.tippy-arrow::before { content: ""; position: absolute; border-color: transparent; border-style: solid; }

.tippy-content { position: relative; padding: 5px 9px; z-index: 1; }

.global-toast[data-sonner-toast] { display: flex; gap: 0px; width: fit-content; max-width: min(26.25rem, -2rem + 100vw); min-height: 2.25rem; padding: 0.5rem 1rem; border-radius: 0.5rem; background: linear-gradient(rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0)), rgb(13, 13, 13); border: 1px solid rgb(13, 13, 13); box-shadow: rgba(0, 0, 0, 0.24) 0px 1px 1px, rgba(0, 0, 0, 0.2) 0px 2px 3px, rgba(255, 255, 255, 0.07) 0px 1px 1px inset; color: rgb(255, 255, 255); overflow: hidden; backdrop-filter: blur(12px); outline: none; }

[data-sonner-toaster][data-x-position="right"] { align-items: flex-end; text-align: right; }

[data-sonner-toaster][data-y-position="top"][data-x-position="center"] { max-width: calc(-2rem + 100vw); display: flex; justify-content: center; }

.global-toast[data-sonner-toast]:focus-visible { box-shadow: rgba(0, 0, 0, 0.24) 0px 1px 1px, rgba(0, 0, 0, 0.2) 0px 2px 3px, rgba(255, 255, 255, 0.07) 0px 1px 1px inset, rgba(255, 255, 255, 0.16) 0px 0px 0px 2px; }

.global-toast[data-sonner-toast] [data-icon] { display: flex; align-items: center; justify-content: center; width: 1.25rem; height: 1.25rem; min-width: 1.25rem; margin: 0px; color: inherit; }

.global-toast[data-sonner-toast] [data-icon] > * { flex-shrink: 0; }

.global-toast[data-sonner-toast] [data-content] { display: flex; flex-direction: column; gap: 0px; min-width: 0px; }

.global-toast__title, .global-toast[data-sonner-toast] [data-title] { padding-left: 0.25rem; margin: 0px; font-size: 0.75rem; font-style: normal; font-weight: 600; line-height: 1.25rem; letter-spacing: 0.06px; color: inherit; word-break: break-word; text-align: left; }

.global-toast__description, .global-toast[data-sonner-toast] [data-description] { padding-left: 0.25rem; margin: -0.125rem 0px 0px; font-size: 0.75rem; font-style: normal; font-weight: 400; line-height: 1rem; letter-spacing: 0.04px; text-align: left; color: rgba(255, 255, 255, 0.72); word-break: break-word; }

@media (max-width: 600px) {
  .global-toast[data-sonner-toast] { max-width: 100%; width: max-content !important; left: 50% !important; transform: translate(-50%) !important; }
}

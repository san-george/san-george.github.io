    linear-gradient(to right, white, transparent 28px, transparent calc(100% - 28px), white); mask-composite: intersect, add; pointer-events: none; z-index: 1; opacity: calc(var(--beam-opacity-bb-2) * 0.26 * var(--beam-strength, 1)); clip-path: inset(0px round 24px); animation: 12s ease-in-out 0s infinite normal none running beam-hue-shift-bb-2; }

[data-beam="bb-2"] [data-beam-bloom] { display: none; position: absolute; inset: 0px; border-radius: 23px; clip-path: inset(0px round 24px); background: conic-gradient(
        from var(--beam-angle-bb-2),
        transparent 0%, transparent 58%,
        rgba(0, 0, 0, 0.02) 62%,
        rgba(0, 0, 0, 0.08) 65%,
        rgba(0, 0, 0, 0.2) 67%,
        rgba(0, 0, 0, 0.4) 69%,
        rgba(0, 0, 0, 0.6) 70%,

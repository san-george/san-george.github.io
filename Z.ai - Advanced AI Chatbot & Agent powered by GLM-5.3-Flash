.driver-popover-footer .driver-popover-btn-disabled { opacity: 0.5; pointer-events: none; }

:not(body):has(> .driver-active-element) { overflow: hidden !important; }

.driver-no-interaction, .driver-no-interaction * { pointer-events: none !important; }

.driver-popover-footer button:hover, .driver-popover-footer button:focus { background-color: rgb(247, 247, 247); }

.driver-popover-navigation-btns { display: flex; flex-grow: 1; justify-content: flex-end; }

.driver-popover-navigation-btns button + button { margin-left: 4px; }

.driver-popover-arrow { content: ""; position: absolute; border: 5px solid rgb(255, 255, 255); }

.driver-popover-arrow-side-over { display: none; }

.driver-popover-arrow-side-left { left: 100%; border-right-color: transparent; border-bottom-color: transparent; border-top-color: transparent; }

.driver-popover-arrow-side-right { right: 100%; border-left-color: transparent; border-bottom-color: transparent; border-top-color: transparent; }

.driver-popover-arrow-side-top { top: 100%; border-right-color: transparent; border-bottom-color: transparent; border-left-color: transparent; }

.driver-popover-arrow-side-bottom { bottom: 100%; border-left-color: transparent; border-top-color: transparent; border-right-color: transparent; }

.driver-popover-arrow-side-center { display: none; }

.driver-popover-arrow-side-left.driver-popover-arrow-align-start, .driver-popover-arrow-side-right.driver-popover-arrow-align-start { top: 15px; }

.driver-popover-arrow-side-top.driver-popover-arrow-align-start, .driver-popover-arrow-side-bottom.driver-popover-arrow-align-start { left: 15px; }

.driver-popover-arrow-align-end.driver-popover-arrow-side-left, .driver-popover-arrow-align-end.driver-popover-arrow-side-right { bottom: 15px; }

.driver-popover-arrow-side-top.driver-popover-arrow-align-end, .driver-popover-arrow-side-bottom.driver-popover-arrow-align-end { right: 15px; }

.driver-popover-arrow-side-left.driver-popover-arrow-align-center, .driver-popover-arrow-side-right.driver-popover-arrow-align-center { top: 50%; margin-top: -5px; }

.driver-popover-arrow-side-top.driver-popover-arrow-align-center, .driver-popover-arrow-side-bottom.driver-popover-arrow-align-center { left: 50%; margin-left: -5px; }

.driver-popover-arrow-none { display: none; }

.nux-tour-popover.driver-popover { background: rgb(46, 144, 250); color: rgb(255, 255, 255); border-radius: 8px; padding: 16px; min-width: 250px; max-width: 300px; box-shadow: rgba(0, 0, 0, 0.12) 0px 0px 0.5px, rgba(0, 0, 0, 0.12) 0px 10px 16px, rgba(0, 0, 0, 0.15) 0px 2px 5px; }

.nux-tour-popover .driver-popover-title { font-size: 13px; font-weight: 600; line-height: 24px; letter-spacing: -0.0325px; color: rgb(255, 255, 255); font-family: Geist, sans-serif; }

.nux-tour-popover .driver-popover-description { font-size: 11px; font-weight: 500; line-height: 16px; letter-spacing: 0.055px; color: rgb(255, 255, 255); margin-top: 8px; font-family: Geist, sans-serif; }

.nux-tour-popover .driver-popover-footer { margin-top: 16px; }

.nux-tour-popover .driver-popover-progress-text { font-size: 11px; font-weight: 500; line-height: 16px; letter-spacing: 0.055px; color: rgba(255, 255, 255, 0.8); font-family: Geist, sans-serif; }

.nux-tour-popover .driver-popover-navigation-btns button { font-size: 11px; font-weight: 500; line-height: 16px; letter-spacing: 0.055px; color: rgb(255, 255, 255); background: transparent; border: 1px solid rgb(255, 255, 255); border-radius: 6px; padding: 8px 13px; text-shadow: none; font-family: Geist, sans-serif; cursor: pointer; }

.nux-tour-popover .driver-popover-navigation-btns button:hover { background: rgba(255, 255, 255, 0.15); }

.nux-tour-popover .driver-popover-close-btn { color: rgba(255, 255, 255, 0.8); font-size: 20px; top: 8px; right: 8px; width: 32px; height: 32px; }

.nux-tour-popover .driver-popover-close-btn:hover, .nux-tour-popover .driver-popover-close-btn:focus { color: rgb(255, 255, 255); }

.nux-tour-popover .driver-popover-arrow { border-color: rgb(46, 144, 250); }

.nux-tour-popover .driver-popover-arrow-side-left { border-right-color: transparent; border-bottom-color: transparent; border-top-color: transparent; }

.nux-tour-popover .driver-popover-arrow-side-right { border-left-color: transparent; border-bottom-color: transparent; border-top-color: transparent; }

.nux-tour-popover .driver-popover-arrow-side-top { border-right-color: transparent; border-bottom-color: transparent; border-left-color: transparent; }

.nux-tour-popover .driver-popover-arrow-side-bottom { border-left-color: transparent; border-top-color: transparent; border-right-color: transparent; }

.nux-tour-popover-folder .driver-popover-arrow-side-right.driver-popover-arrow-align-start { top: 11px; }

@keyframes svelte-1v2axqk-l { 
  100% { clip-path: inset(0px -1ch 0px 0px); }
}


@charset "utf-8";

#aliyunCaptcha-float-wrapper { z-index: var(--aliyun-captcha-z-index-base); position: relative; display: inline-block; transform: scale(var(--aliyun-zoom-ratio, 1)); }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper { z-index: var(--aliyun-captcha-z-index-base); position: relative; margin-bottom: 4px; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body { display: flex; align-items: center; justify-content: space-between; height: var(--aliyun-slide-height); width: var(--aliyun-slide-width); background: rgb(241, 241, 242); position: relative; margin: 0px; border-radius: 4px; user-select: none; -webkit-user-drag: none; box-sizing: border-box; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body #aliyunCaptcha-captcha-left { display: flex; align-items: center; justify-content: flex-start; margin-left: var(--aliyun-captcha-size); height: 100%; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body #aliyunCaptcha-captcha-left #aliyunCaptcha-start-icon { flex-shrink: 0; font-family: aliyun-captcha-iconfont; width: var(--aliyun-captcha-size); height: var(--aliyun-captcha-size); margin-right: 8px; opacity: 1; box-sizing: border-box; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body #aliyunCaptcha-captcha-left #aliyunCaptcha-captcha-text-box { flex-grow: 1; height: 100%; z-index: 1; background: rgba(0, 0, 0, 0); cursor: pointer; font-size: 14px; font-weight: 400; display: flex; align-items: center; justify-content: flex-start; font-family: aliyun-captcha-iconfont; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body #aliyunCaptcha-captcha-left #aliyunCaptcha-captcha-text-box.verified { color: rgb(0, 148, 49); }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body #aliyunCaptcha-captcha-left #aliyunCaptcha-captcha-text-box.fail { color: rgb(224, 0, 0); }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body #aliyunCaptcha-captcha-left #aliyunCaptcha-loading { width: var(--aliyun-captcha-size); height: var(--aliyun-captcha-size); position: relative; display: none; margin-right: 8px; align-items: center; justify-content: center; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body #aliyunCaptcha-captcha-left #aliyunCaptcha-loading .aliyunCaptcha-loader { font-size: 2px; color: rgb(51, 51, 51); }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body.verified { justify-content: center; background: rgb(228, 255, 237); }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body.fail { justify-content: center; background-color: rgb(255, 234, 234); }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body .aliyunCaptcha-captcha-logo-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; margin-right: var(--aliyun-captcha-size); flex-shrink: 0; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body #aliyunCaptcha-captcha-logo { height: var(--aliyun-captcha-size); font-family: aliyun-captcha-iconfont; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body .aliyunCaptcha-captcha-logo-link { display: none; font-size: 6px; line-height: 1.2; margin-top: 2px; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: rgb(102, 102, 102); text-decoration: none; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body .aliyunCaptcha-captcha-logo-link:hover { text-decoration: underline; }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body.hover-active:hover { cursor: pointer; color: rgb(0, 100, 200); background: rgb(247, 249, 250); }

#aliyunCaptcha-float-wrapper #aliyunCaptcha-captcha-wrapper #aliyunCaptcha-captcha-body.hover-active:active { background: rgb(230, 238, 245); }

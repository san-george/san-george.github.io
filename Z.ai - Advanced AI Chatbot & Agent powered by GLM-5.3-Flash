.glass-container { backdrop-filter: blur(3px); border-width: 1px 0px 0px 1px; border-style: solid; border-color: rgba(255, 255, 255, 0.4) rgba(40, 40, 40, 0.35) rgba(40, 40, 40, 0.35) rgba(255, 255, 255, 0.4); border-image: none; box-shadow: rgba(0, 0, 0, 0.3) 2px 8px 8px; }

@keyframes scheduled-rise { 
  0% { opacity: 0; filter: blur(2px); translate: 0px 8px; }
}

.scheduled-rise { animation-duration: 0.48s; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); animation-iteration-count: 1; animation-direction: normal; animation-fill-mode: both; animation-play-state: running; animation-name: scheduled-rise; animation-timeline: auto; animation-range: normal; animation-delay: var(--scheduled-delay,0s); }

@keyframes scheduled-hero-enter { 
  0% { opacity: 0; filter: blur(8px); scale: 1.04; }
}

@keyframes scheduled-hero-drift { 
  0% { transform: translate(-14px, 2px) scale(1.04); }
  100% { transform: translate(14px, -6px) scale(1.07); }
}

.scheduled-hero-enter { animation: 1.2s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running scheduled-hero-enter; }

.scheduled-hero-drift { will-change: transform; animation: 20s ease-in-out 0s infinite alternate none running scheduled-hero-drift; }

html[data-scheduled-vt="page"] .scheduled-vt-title { view-transition-name: scheduled-page-title; }

html[data-scheduled-vt="page"] .scheduled-vt-content { view-transition-name: scheduled-page-content; }

html[data-scheduled-vt="page"]::view-transition-old(root) { animation: auto ease 0s 1 normal none running none; }

html[data-scheduled-vt="page"]::view-transition-new(root) { animation: 0.2s ease-out 0s 1 normal both running scheduled-vt-in; }

html[data-scheduled-vt="page"]::view-transition-group(scheduled-page-title) { animation-duration: 0.38s; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }

html[data-scheduled-vt="page"]::view-transition-group(scheduled-page-content) { animation-duration: 0.38s; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); }

html[data-scheduled-vt="page"]::view-transition-old(scheduled-page-title) { width: auto; height: auto; }

html[data-scheduled-vt="page"]::view-transition-new(scheduled-page-title) { width: auto; height: auto; }

html[data-scheduled-vt="page"]::view-transition-old(scheduled-page-content) { width: auto; height: auto; }

html[data-scheduled-vt="page"]::view-transition-new(scheduled-page-content) { width: auto; height: auto; }

html[data-scheduled-vt="page"]::view-transition-old(scheduled-page-title) { animation: 0.18s ease-out 0s 1 normal both running scheduled-vt-out; }

html[data-scheduled-vt="page"]::view-transition-new(scheduled-page-title) { animation: 0.24s ease-out 0s 1 normal both running scheduled-vt-in; }

html[data-scheduled-vt="page"]::view-transition-old(scheduled-page-content) { animation: 0.14s ease-out 0s 1 normal both running scheduled-vt-out; }

html[data-scheduled-vt="page"]::view-transition-new(scheduled-page-content) { animation: 0.26s ease-out 60ms 1 normal both running scheduled-vt-in; }

@keyframes scheduled-vt-in { 
  0% { opacity: 0; }
}

@keyframes scheduled-vt-out { 
  100% { opacity: 0; }
}

@keyframes scheduled-prompt-swap { 
  0% { opacity: 0; translate: 0px 4px; }
}

.scheduled-prompt-swap { animation: 0.18s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running scheduled-prompt-swap; }

.scheduled-guide-sequence .scheduled-guide-card { animation: scheduled-guide-card .56s cubic-bezier(.16,1,.3,1)var(--scheduled-guide-delay,0s)both; }

.scheduled-guide-sequence .scheduled-guide-tape { animation: scheduled-guide-tape .42s cubic-bezier(.34,1.56,.64,1)var(--scheduled-guide-delay,0s)both; }

.scheduled-guide-sequence .scheduled-guide-line { animation: scheduled-guide-line .52s ease-out var(--scheduled-guide-delay,0s)both; }

@keyframes scheduled-guide-card { 
  0% { opacity: 0; translate: 0px 12px; scale: 0.97; }
}

@keyframes scheduled-guide-tape { 
  0% { opacity: 0; rotate: -10deg; scale: 1.35; }
}

@keyframes scheduled-guide-line { 
  0% { clip-path: inset(0px 100% 0px 0px); }
}

.scheduled-guide-quick .scheduled-guide-card { animation: 0.42s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running scheduled-guide-card; }

.scheduled-guide-quick .scheduled-guide-line { animation: 0.42s ease-out 0.12s 1 normal both running scheduled-guide-line; }

.scheduled-guide-sway { transform-origin: var(--scheduled-guide-origin,50% 0); animation: scheduled-guide-sway var(--scheduled-guide-duration,6.4s)ease-in-out var(--scheduled-guide-phase,0s)infinite; }

.scheduled-guide-sway:hover, .scheduled-guide-sway:focus-within { animation-play-state: paused; }

@keyframes scheduled-guide-sway { 
  0%, 100% { translate: 0px; rotate: -0.6deg; }
  50% { translate: 0px 2px; rotate: 0.6deg; }
}

.scheduled-guide-flow { animation: 0.9s linear 0s infinite normal none running scheduled-guide-flow; }

@keyframes scheduled-guide-flow { 
  100% { stroke-dashoffset: -8px; }
}

.scheduled-guide-ping { opacity: 0; animation: 2.8s cubic-bezier(0, 0, 0.2, 1) 1.6s infinite normal none running scheduled-guide-ping; }

@keyframes scheduled-guide-ping { 
  0% { opacity: 0.35; scale: 1; }
  40%, 100% { opacity: 0; scale: 2; }
}

@media (prefers-reduced-motion: reduce) {
  .scheduled-page, .scheduled-page * { scroll-behavior: auto !important; transition-duration: 0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; }
  .scheduled-hero-enter, .scheduled-hero-drift, .scheduled-rise, .scheduled-prompt-swap, .scheduled-guide-card, .scheduled-guide-tape, .scheduled-guide-line, .scheduled-guide-sway, .scheduled-guide-flow, .scheduled-guide-ping { animation: auto ease 0s 1 normal none running none !important; }
}


Content-Location: cid:css-38f1e054-e331-4e18-ae05-7c82b8dc63e3@mhtml.blink

@charset "utf-8";

#aliyunCaptcha-img-box { background: rgba(0, 0, 0, 0.08); position: relative; margin: 8px 0px; width: 300px; overflow: hidden; }

#aliyunCaptcha-img-box.puzzle { height: var(--aliyun-imgbox-height, 200px); }

#aliyunCaptcha-img-box button { color: rgb(255, 255, 255); position: absolute; font-size: 18px; top: 0px; right: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; display: flex; justify-content: center; align-items: center; cursor: pointer; width: 32px; height: 32px; opacity: 1; background: rgba(0, 0, 0, 0.6); }

#aliyunCaptcha-img { position: absolute; top: 0px; left: 0px; margin: 0px auto; width: 300px; user-select: none; -webkit-user-drag: none; }

#aliyunCaptcha-img.puzzle { height: var(--aliyun-imgbox-height, 200px); }

#aliyunCaptcha-puzzle { position: absolute; top: 0px; left: 0px; margin: 0px auto; user-select: none; -webkit-user-drag: none; }

#aliyunCaptcha-sliding-body { height: var(--aliyun-puzzle-slide-height); background: rgb(246, 246, 246); position: relative; margin-bottom: 4px; padding: 0px; border-radius: 4px; user-select: none; -webkit-user-drag: none; }

#aliyunCaptcha-sliding-body.puzzle { width: 300px; }

#aliyunCaptcha-sliding-body.verified { background: rgb(228, 255, 237); }

#aliyunCaptcha-sliding-body.fail { background-color: rgb(255, 234, 234); }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-left { position: absolute; height: 100%; border-radius: 4px; background-color: rgb(228, 255, 237); }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-left.width-change { transition: width 0.5s; }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-left.width-change.initial { width: 0px; }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-left.finished { background-color: rgb(246, 246, 246); }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-left.fail { background-color: rgb(255, 234, 234); }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-slider { text-align: center; width: 40px; height: var(--aliyun-puzzle-slide-height); line-height: var(--aliyun-puzzle-slide-height); font-size: 16px; position: absolute; left: 0px; background: rgb(255, 255, 255); color: rgb(170, 170, 170); z-index: 2; font-family: aliyun-captcha-iconfont; box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 10px 0px; border-radius: 4px; border-width: 1px; }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-slider:hover { cursor: pointer; }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-slider.slider-move { transition: left 0.2s; }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-slider.slider-move.initial { left: 0px; pointer-events: all; }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-slider.ok { color: rgb(148, 208, 109); }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-slider.fail { background: rgb(200, 0, 0); }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-text-box { height: 100%; width: 100%; text-align: center; position: absolute; z-index: 1; background: rgba(0, 0, 0, 0); cursor: pointer; font-size: 15px; font-weight: 400; font-family: PingFangSC; color: rgb(246, 246, 246); display: flex; justify-content: center; align-items: center; }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-text-box .aliyunCaptcha-sliding-text { color: rgb(170, 170, 170); background-image: -webkit-gradient(linear, 0% 0%, 100% 0%, from(rgb(179, 179, 179)), color-stop(0.4, rgb(179, 179, 179)), color-stop(0.5, rgb(255, 255, 255)), color-stop(0.6, rgb(179, 179, 179)), to(rgb(179, 179, 179))); background-size: 300% 100%; background-clip: text; -webkit-text-fill-color: rgba(0, 0, 0, 0); animation: 6s linear 0s infinite normal none running slidingtext; width: 220px; }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-text-box.slided { color: rgb(85, 85, 85); }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-text-box.verified { color: rgb(0, 148, 49); }

#aliyunCaptcha-sliding-body #aliyunCaptcha-sliding-text-box.fail { color: rgb(224, 0, 0); }

@-webkit-keyframes slidingtext { 
  0% { background-position: 150% 0px; }
  100% { background-position: -150% 0px; }
}

@keyframes slidingtext { 
  0% { background-position: 150% 0px; }
  100% { background-position: -150% 0px; }
}

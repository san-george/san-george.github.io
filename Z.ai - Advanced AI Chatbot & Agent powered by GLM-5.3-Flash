.ppt-editor-toolbar-enter, .ppt-editor-left-enter, .ppt-editor-center-enter, .ppt-editor-right-enter { will-change: transform, opacity, filter; }

.ppt-editor-toolbar-enter { animation: 0.42s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running ppt-editor-toolbar-in; }

.ppt-editor-left-enter { animation: 0.56s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running ppt-editor-left-in; }

.ppt-editor-center-enter { animation: 0.68s cubic-bezier(0.16, 1, 0.3, 1) 80ms 1 normal both running ppt-editor-center-in; }

.ppt-editor-right-enter { animation: 0.56s cubic-bezier(0.16, 1, 0.3, 1) 0s 1 normal both running ppt-editor-right-in; }

@keyframes ppt-editor-toolbar-in { 
  0% { opacity: 0; transform: translate3d(0px, -100%, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes ppt-editor-left-in { 
  0% { opacity: 0; transform: translate3d(-100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@keyframes ppt-editor-center-in { 
  0% { opacity: 0; filter: blur(6px); transform: scale(0.96); }
  100% { opacity: 1; filter: blur(0px); transform: scale(1); }
}

@keyframes ppt-editor-right-in { 
  0% { opacity: 0; transform: translate3d(100%, 0px, 0px); }
  100% { opacity: 1; transform: translateZ(0px); }
}

@media (prefers-reduced-motion: reduce) {
  .ppt-editor-toolbar-enter, .ppt-editor-left-enter, .ppt-editor-center-enter, .ppt-editor-right-enter { animation: auto ease 0s 1 normal none running none; filter: none; transform: none; }
}


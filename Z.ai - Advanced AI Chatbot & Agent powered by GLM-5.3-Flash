figure img { margin-inline: auto; }

details summary { list-style: none; }

details summary .chev { transform-origin: 50% center; transition: transform 0.25s; }

details[open] summary .chev { transform: rotate(90deg); }

.details-content { max-height: 0px; transition: max-height 0.28s; overflow: hidden; }

.markdown a { text-decoration-line: underline; }

.font-primary { font-family: system-ui, ui-sans-serif; }

.drag-region { app-region: drag; }

.drag-region a, .drag-region button, .no-drag-region { app-region: no-drag; }

li p { display: inline; }

::-webkit-scrollbar-thumb { --tw-border-opacity: 1; border-color: rgba(255,255,255,var(--tw-border-opacity)); background: rgba(0, 0, 0, 0.12); border-width: 1px; border-radius: 9999px; }

.dark ::-webkit-scrollbar-thumb { border-color: rgba(0,0,0,var(--tw-border-opacity)); background: rgba(255, 255, 255, 0.12); }

::-webkit-scrollbar { width: 4px; height: 4px; }

* { scrollbar-width: thin; }

::-webkit-scrollbar-track { background-color: rgba(0, 0, 0, 0); border-radius: 9999px; }

select { print-color-adjust: exact; appearance: none; background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3E%3Cpath stroke='%236B7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3E%3C/svg%3E"); background-position: right 0px center; background-repeat: no-repeat; background-size: 1.5em 1.5em; }

@keyframes shimmer { 
  0% { background-position: 100% 0px; }
  100% { background-position: -100% 0px; }
}

.shimmer { background-image: linear-gradient(90deg,var(--color-text-tertiary)0%,var(--color-text-tertiary)35%,var(--color-text-primary)50%,var(--color-text-tertiary)65%,var(--color-text-tertiary)100%); -webkit-text-fill-color: transparent; color: var(--color-text-tertiary); background-size: 200% 100%; background-clip: text; animation: 3s linear 0s infinite normal none running shimmer; }

@keyframes pptTemplateFadeIn { 
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0px); }
}

@keyframes smoothFadeIn { 
  0% { opacity: 0; transform: translateY(-10px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.status-description { animation: 0.2s ease 0s 1 normal forwards running smoothFadeIn; }

.katex-mathml { display: none; }

.scrollbar-hidden:active::-webkit-scrollbar-thumb { visibility: visible; }

.scrollbar-hidden:focus::-webkit-scrollbar-thumb { visibility: visible; }

.scrollbar-hidden:hover::-webkit-scrollbar-thumb { visibility: visible; }

.scrollbar-hidden::-webkit-scrollbar-thumb { visibility: hidden; }

.scrollbar-hidden::-webkit-scrollbar-corner { display: none; }

.scrollbar-none::-webkit-scrollbar { display: none; }


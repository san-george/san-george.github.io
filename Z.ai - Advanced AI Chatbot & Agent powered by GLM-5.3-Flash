  :is(:is(#highlightParamsToolbarContainer #editorHighlightVisibility) .divider) * { --csstools-light-dark-toggle--93: var(--csstools-color-scheme--light) #8f8f9d; --divider-color: var(--csstools-light-dark-toggle--93, #d7d7db); }

#editorCommentsSidebar { display: flex; height: auto; padding-bottom: 16px; flex-direction: column; align-items: flex-start; }

#editorCommentsSidebar #editorCommentsSidebarHeader { width: 100%; box-sizing: border-box; padding: 16px; display: flex; align-items: center; justify-content: space-between; }

:is(#editorCommentsSidebar #editorCommentsSidebarHeader) .commentCount { display: flex; align-items: baseline; gap: 6px; user-select: none; }

